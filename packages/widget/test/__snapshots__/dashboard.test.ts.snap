exports[`renderDashboardShell — snapshots > shell snapshot: decisions-audiences 1`] = `"<div class="dash-title">What resolve() decided</div><div class="grid" style="--cols:3"><div class="cell chart"><div class="cell-chart" id="cell-0"></div><div class="cell-notes">Showing the top 30 of 40 categories by value.</div></div><div class="cell chart"><div class="cell-chart" id="cell-1"></div><div class="cell-notes">Column &quot;week&quot; looks like non-ISO dates; plotted as unordered categories. Return ISO dates (YYYY-MM-DD) for a sorted time axis.</div></div><div class="cell chart"><div class="cell-chart" id="cell-2"></div><div class="cell-notes">Summed 2 row(s) that shared the same status — the data looked unaggregated.</div></div></div>"`;

exports[`renderDashboardShell — snapshots > shell snapshot: decisions-errors 1`] = `"<div class="dash-title">Failures and advisories</div><div class="grid" style="--cols:2"><div class="cell chart"><div class="cell-chart" id="cell-0"></div><div class="cell-error">warehouse connection lost mid-render</div></div><div class="cell kpi"><div class="kpi-label">Refunds</div><div class="kpi-value">—</div><div class="cell-error">query timed out after 30s</div></div><div class="cell chart"><div class="cell-chart" id="cell-2"></div></div></div><div class="dash-notes">1 of 3 items failed to build; the dashboard is incomplete. Figures are illustrative and exclude intercompany revenue.</div>"`;

